rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Artículos: lectura pública (es el contenido gratis con anuncios), escritura solo desde el backend (admin SDK bypasea rules).
    match /articulos/{articuloId} {
      allow read: if true;
      allow write: if false;
    }

    // Doc de usuario: cada uno solo puede leer el suyo (incluye el flag "premium" que saca los anuncios).
    // Escritura solo desde la consola de Firebase / Admin SDK: un usuario no puede otorgarse premium a sí mismo.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Estado de "leído" por usuario: cada usuario solo puede leer/escribir su propia subcolección, y solo si verificó su email.
    match /usuarios/{uid}/leidos/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }

    // Chat global: lectura para cualquier usuario verificado, escritura solo de mensajes propios (sin edición, con borrado solo del propio mensaje).
    match /chatGlobal/{msgId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 500;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Todo lo demás: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
