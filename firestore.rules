rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Artículos: lectura solo para usuarios con email verificado (Google siempre lo tiene), escritura solo desde el backend (admin SDK bypasea rules).
    match /articulos/{articuloId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow write: if false;
    }

    // Estado de "leído" por usuario: cada usuario solo puede leer/escribir su propia subcolección, y solo si verificó su email.
    match /usuarios/{uid}/leidos/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }

    // Todo lo demás: denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
